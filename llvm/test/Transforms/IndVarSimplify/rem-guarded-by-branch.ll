define void @urem_guarded_by_branch(i32 %m, ptr %p) {
; CHECK-LABEL: define void @urem_guarded_by_branch(
; CHECK-SAME: i32 [[M:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
