; RUN: opt < %s -disable-output "-passes=print<scalar-evolution>" 2>&1 | FileCheck %s

; n is a multiple of 2 only because of the check before the loop, so the loop
; exits after n / 2 iterations.

define void @n_is_even_by_entry_check(i32 %n) {
; CHECK-LABEL: 'n_is_even_by_entry_check'
; CHECK-NEXT:  Classifying expressions for: @n_is_even_by_entry_check
; CHECK-NEXT:    %rem = urem i32 %n, 2
; CHECK-NEXT:    --> (zext i1 (trunc i32 %n to i1) to i32) U: [0,2) S: [0,2)
; CHECK-NEXT:    %iv = phi i32 [ 0, %ph ], [ %iv.next, %body ]
; CHECK-NEXT:    --> {0,+,2}<nuw><%loop> U: [0,-1) S: [-2147483648,2147483647) Exits: (2 * (%n /u 2))<nuw> LoopDispositions: { %loop: Computable }
; CHECK-NEXT:    %iv.next = add i32 %iv, 2
; CHECK-NEXT:    --> {2,+,2}<nw><%loop> U: [0,-1) S: [-2147483648,2147483647) Exits: (2 + (2 * (%n /u 2))<nuw>) LoopDispositions: { %loop: Computable }
; CHECK-NEXT:  Determining loop execution counts for: @n_is_even_by_entry_check
; CHECK-NEXT:  Loop %loop: backedge-taken count is (%n /u 2)
; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 2147483647
; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (%n /u 2)
; CHECK-NEXT:  Loop %loop: Trip multiple is 1
;
entry:
  %rem = urem i32 %n, 2
  %guard = icmp eq i32 %rem, 0
  br i1 %guard, label %ph, label %exit

ph:
  br label %loop

loop:
  %iv = phi i32 [ 0, %ph ], [ %iv.next, %body ]
  %c = icmp ne i32 %iv, %n
  br i1 %c, label %body, label %exit

body:
  %iv.next = add i32 %iv, 2
  br label %loop

exit:
  ret void
}
